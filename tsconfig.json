{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "es2020"
    ],
    "outDir": "lib",
    "rootDir": "src",
    "moduleResolution": "node",
    "module": "commonjs",
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "declaration": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false
  },
  "include": [
    "src/**/*.ts"
  ]
}
